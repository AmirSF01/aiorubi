msgid "Default"
msgstr  "پیش‌فرض"

msgid "Default bot properties propagated into API method calls."
msgstr  "ویژگی‌های پیش‌فرض بات که به فراخوانی متدهای API منتقل می‌شوند."

msgid "Parameters"
msgstr  "پارامترها"

msgid "Default bot properties."
msgstr  "ویژگی‌های پیش‌فرض بات."

msgid "Return type"
msgstr  "نوع بازگشتی"

msgid "Allows to send messages without reply."
msgstr  "اجازهٔ ارسال پیام بدون نقل‌قول (ریپلای) را می‌دهد."

msgid "Sends the message silently. Users will receive a notification with no sound."
msgstr "پیام را بی‌صدا ارسال می‌کند. کاربران اعلانی بدون صدا دریافت خواهند کرد."

msgid "Default parse mode for messages."
msgstr  "حالت پارس پیش‌فرض برای پیام‌ها."

