#: ../../api/client/session.rst:3
msgid "Session"
msgstr "سشن"

#: ../../api/client/session.rst:5
msgid "HTTP session layer used by :class:`~aiorubi.client.bot.Bot` to talk to the Rubika Bot API."
msgstr "لایهٔ سشن HTTP که :class:`~aiorubi.client.bot.Bot` برای صحبت با Rubika Bot API استفاده می‌کند."

#: ../../api/client/session.rst:9
msgid "Base session"
msgstr "سشن پایه"

#: aiorubi.client.session.base.BaseSession:1 of
msgid "This is base class for all HTTP sessions in aiorubi."
msgstr "این کلاس پایهٔ همهٔ سشن‌های HTTP در aiorubi است."

#: aiorubi.client.session.base.BaseSession:3 of
msgid "If you want to create your own session, you must inherit from this class."
msgstr "اگر می‌خواهید سشن خودتان را بسازید، باید از این کلاس ارث ببرید."

#: ../../api/client/session.rst
#: aiorubi.client.session.aiohttp.AiohttpSession.stream_content
#: aiorubi.client.session.aiohttp.AiohttpSession.upload_file
#: aiorubi.client.session.base.BaseSession.__call__
#: aiorubi.client.session.base.BaseSession.check_response
#: aiorubi.client.session.base.BaseSession.prepare_value
#: aiorubi.client.session.base.BaseSession.stream_content
#: aiorubi.client.session.middlewares.manager.RequestMiddlewareManager.register
#: of
msgid "Parameters"
msgstr "پارامترها"

#: aiorubi.client.session.base.BaseSession.__call__:1 of
msgid "Call self as a function."
msgstr "خود را به‌عنوان تابع فراخوانی کن."

#: ../../api/client/session.rst
#: aiorubi.client.session.aiohttp.AiohttpSession.close
#: aiorubi.client.session.aiohttp.AiohttpSession.stream_content
#: aiorubi.client.session.aiohttp.AiohttpSession.upload_file
#: aiorubi.client.session.base.BaseSession.__call__
#: aiorubi.client.session.base.BaseSession.check_response
#: aiorubi.client.session.base.BaseSession.close
