#: aiorubi.enums.update_type.UpdateType.INLINE_MESSAGE:1 of
msgid "Added for abstraction (not in official API)."
msgstr "برای انتزاع اضافه شده (در API رسمی وجود ندارد)."

#: aiorubi.enums.chat_type.ChatType:1 of
msgid "This object represents a chat type."
msgstr "این شیء نوع چت را نشان می‌دهد."

#: aiorubi.enums.chat_keypad_type.ChatKeypadType:1 of
msgid "This object represents a type of chat keypad update."
msgstr "این شیء نوع به‌روزرسانی کیبورد چت را نشان می‌دهد."

#: aiorubi.enums.file_type.FileType:1 of
msgid "This object represents a type of file."
msgstr "این شیء نوع فایل را نشان می‌دهد."

#: aiorubi.enums.button_type.ButtonType:1 of
msgid "Represents the type of behavior and display of a button."
msgstr "نوع رفتار و نمایش دکمه را نشان می‌دهد."

#: aiorubi.enums.button_type.ButtonType:3 of
msgid "Source: https://rubika.ir/botapi/models#buttontypeenum"
msgstr "منبع: https://rubika.ir/botapi/models#buttontypeenum"

#: aiorubi.enums.poll_type.PollType:1 of
msgid "This object represents a type of poll."
msgstr "این شیء نوع نظرسنجی را نشان می‌دهد."

#: aiorubi.enums.poll_status.PollStatus:1 of
msgid "This object represents a status of a poll."
msgstr "این شیء وضعیت یک نظرسنجی را نشان می‌دهد."

#: aiorubi.enums.message_sender_type.MessageSenderType:1 of
msgid "This object represents a type of message sender."
msgstr "این شیء نوع فرستندهٔ پیام را نشان می‌دهد."

#: aiorubi.enums.update_endpoint_type.UpdateEndpointType:1 of
msgid "This object represents a type of update endpoint."
msgstr "این شیء نوع endpoint آپدیت را نشان می‌دهد."

#: aiorubi.enums.metadata_type.MetadataType:1 of
msgid "This object represents a type of metadata."
msgstr "این شیء نوع متادیتا را نشان می‌دهد."

#: aiorubi.enums.metadata_type.MetadataType:3 of
msgid "Source: https://rubika.ir/botapi/models#metadataTypeEnum"
msgstr "منبع: https://rubika.ir/botapi/models#metadataTypeEnum"

#: aiorubi.enums.forwarded_from_type.ForwardedFromType:1 of
msgid "This object represents a type of forwarded message source."
msgstr "این شیء نوع مبدأ پیام فورواردشده را نشان می‌دهد."

#: aiorubi.enums.button_textbox_type_line.ButtonTextboxTypeLine:1 of
msgid "This object represents an input line mode for textbox button."
msgstr "این شیء حالت خط ورودی برای دکمهٔ جعبهٔ متن را نشان می‌دهد."

#: aiorubi.enums.button_textbox_type_keypad.ButtonTextboxTypeKeypad:1 of
msgid "This object represents a type of keypad for textbox button."
msgstr "این شیء نوع کیبورد برای دکمهٔ جعبهٔ متن را نشان می‌دهد."

#: aiorubi.enums.button_selection_type.ButtonSelectionType:1 of
msgid "This object represents a type of button selection display."
msgstr "این شیء نوع نمایش انتخاب دکمه را نشان می‌دهد."

#: aiorubi.enums.button_selection_search.ButtonSelectionSearch:1 of
msgid "This object represents a search type for button selection."
msgstr "این شیء نوع جستجو برای انتخاب دکمه را نشان می‌دهد."

#: aiorubi.enums.button_selection_get.ButtonSelectionGet:1 of
msgid "This object represents a get type for button selection."
msgstr "این شیء نوع دریافت برای انتخاب دکمه را نشان می‌دهد."

#: aiorubi.enums.button_location_type.ButtonLocationType:1 of
msgid "This object represents a type of button location."
msgstr "این شیء نوع موقعیت مکانی دکمه را نشان می‌دهد."

#: aiorubi.enums.button_calendar_type.ButtonCalendarType:1 of
msgid "This object represents a type of button calendar."
msgstr "این شیء نوع تقویم دکمه را نشان می‌دهد."

