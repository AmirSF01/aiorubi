msgstr "نام کالکشن ذخیرهٔ حالت‌ها و دادهٔ FSM"

#: aiorubi.fsm.storage.mongo.MongoStorage.close:1
#: aiorubi.fsm.storage.pymongo.PyMongoStorage.close:1 of
msgid "Cleanup client resources and disconnect from MongoDB."
msgstr "پاک‌سازی منابع کلاینت و قطع اتصال از MongoDB."

#: aiorubi.fsm.storage.mongo.MongoStorage.from_url:1 of
msgid "Create an instance of :class:`MongoStorage` with specifying the connection string"
msgstr "ساخت نمونه‌ای از :class:`MongoStorage` با مشخص‌کردن رشتهٔ اتصال"

#: aiorubi.fsm.storage.mongo.MongoStorage.from_url:3 of
msgid "for example :code:`mongodb://user:password@host:port`"
msgstr "مثلاً :code:`mongodb://user:***@host:port`"

#: aiorubi.fsm.storage.mongo.MongoStorage.from_url:4 of
msgid "see :code:`motor` docs"
msgstr "ببینید مستندات :code:`motor`"

#: aiorubi.fsm.storage.mongo.MongoStorage.from_url:5 of
msgid "arguments to be passed to :class:`MongoStorage`"
msgstr "آرگومان‌هایی که به :class:`MongoStorage` پاس داده می‌شوند"

#: aiorubi.fsm.storage.mongo.MongoStorage.from_url:6 of
msgid "an instance of :class:`MongoStorage`"
msgstr "یک نمونهٔ :class:`MongoStorage`"

