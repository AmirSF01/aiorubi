msgstr "یک جنراتور async"

#: aiorubi.fsm.storage.base.KeyBuilder:1 of
msgid "Base class for key builder."
msgstr "کلاس پایهٔ سازندهٔ کلید."

#: aiorubi.fsm.storage.base.DefaultKeyBuilder.build:1
#: aiorubi.fsm.storage.base.KeyBuilder.build:1 of
msgid "Build key to be used in storage's db queries"
msgstr "ساخت کلیدی که در کوئری‌های دیتابیس استورج استفاده می‌شود"

#: aiorubi.fsm.storage.base.DefaultKeyBuilder.build:3
#: aiorubi.fsm.storage.base.KeyBuilder.build:3 of
msgid "contextual key"
msgstr "کلید کانتکستی"

#: aiorubi.fsm.storage.base.DefaultKeyBuilder.build:4
#: aiorubi.fsm.storage.base.KeyBuilder.build:4 of
msgid "part of the record"
msgstr "بخشی از رکورد"

#: aiorubi.fsm.storage.base.DefaultKeyBuilder.build:5
#: aiorubi.fsm.storage.base.KeyBuilder.build:5 of
msgid "key to be used in storage's db queries"
msgstr "کلیدی که در کوئری‌های دیتابیس استورج استفاده می‌شود"

#: aiorubi.fsm.storage.base.DefaultKeyBuilder:1 of
msgid "Simple key builder with default prefix."
msgstr "سازندهٔ کلید ساده با پیشوند پیش‌فرض."

#: aiorubi.fsm.storage.base.DefaultKeyBuilder:3 of
msgid "Generates a colon-joined string with prefix, chat_id, user_id, optional bot_id, destiny and field."
msgstr "رشته‌ای با جداکنندهٔ دونقطه تولید می‌کند شامل prefix، chat_id، user_id، bot_id اختیاری، destiny و field."

#: aiorubi.fsm.storage.base.DefaultKeyBuilder:6 of
msgid "Format:"
msgstr "قالب:"

#: aiorubi.fsm.storage.base.DefaultKeyBuilder:7 of
msgid ":code:`<prefix>:<bot_id?>:<chat_id>:<user_id>:<destiny?>:<field?>`"
msgstr ":code:`<prefix>:<bot_id?>:<chat_id>:<user_id>:<destiny?>:<field?>`"

#: ../../api/fsm/storage.rst:30
msgid "Memory"
msgstr "حافظه"

#: aiorubi.fsm.storage.memory.MemoryStorage:1 of
msgid "Default FSM storage; uses a regular :class:`dict` to store data and does not persist it across restarts."
msgstr "استورج پیش‌فرض FSM؛ از یک :class:`dict` معمولی برای ذخیرهٔ داده استفاده می‌کند و آن را بین ری‌استارت‌ها ماندگار نمی‌کند."

#: aiorubi.fsm.storage.memory.MemoryStorage:6 of
msgid "This storage is not recommended for production use, as all data is lost when the bot restarts"
msgstr "این استورج برای استفادهٔ production توصیه نمی‌شود، چون همهٔ داده با ری‌استارت بات از بین می‌رود"

#: ../../api/fsm/storage.rst:43
msgid "Redis"
msgstr "Redis"

#: aiorubi.fsm.storage.redis.RedisStorage:1 of
msgid "Redis storage requires the :code:`redis` package (:code:`pip install redis`)"
msgstr "استورج Redis به پکیج :code:`redis` نیاز دارد (:code:`pip install redis`)"

#: aiorubi.fsm.storage.redis.RedisStorage.__init__:1 of
msgid "instance of Redis connection"
msgstr "نمونه‌ای از اتصال Redis"

