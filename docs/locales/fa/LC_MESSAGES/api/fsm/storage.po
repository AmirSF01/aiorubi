msgid "name of the MongoDB database for FSM"
msgstr "نام دیتابیس MongoDB برای FSM"

#: aiorubi.fsm.storage.mongo.MongoStorage.__init__:4
#: aiorubi.fsm.storage.pymongo.PyMongoStorage.__init__:4 of
