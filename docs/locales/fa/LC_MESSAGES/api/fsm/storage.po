msgid "builder that helps to convert contextual key to string"
msgstr "سازنده‌ای که کلید کانتکستی را به رشته تبدیل می‌کند"

#: aiorubi.fsm.storage.redis.RedisStorage.__init__:3 of
msgid "TTL for state records"
msgstr "TTL رکوردهای حالت"

#: aiorubi.fsm.storage.redis.RedisStorage.__init__:4 of
msgid "TTL for data records"
msgstr "TTL رکوردهای داده"

#: aiorubi.fsm.storage.redis.RedisStorage.from_url:1 of
msgid "Create an instance of :class:`RedisStorage` with the specified connection url"
msgstr "ساخت نمونه‌ای از :class:`RedisStorage` با URL اتصال مشخص‌شده"

#: aiorubi.fsm.storage.redis.RedisStorage.from_url:3 of
msgid "the connection url (i.e. :code:`redis://user:password@host:port/db`)"
msgstr "URL اتصال (یعنی :code:`redis://user:***@host:port/db`)"

#: aiorubi.fsm.storage.redis.RedisStorage.from_url:4 of
msgid "see :code:`redis` docs"
msgstr "ببینید مستندات :code:`redis`"

#: aiorubi.fsm.storage.redis.RedisStorage.from_url:5 of
msgid "arguments passed to :class:`RedisStorage`"
msgstr "آرگومان‌های پاس‌داده‌شده به :class:`RedisStorage`"

#: aiorubi.fsm.storage.redis.RedisStorage.from_url:6 of
msgid "an instance of :class:`RedisStorage`"
msgstr "یک نمونهٔ :class:`RedisStorage`"

#: ../../api/fsm/storage.rst:50
msgid "Mongo"
msgstr "Mongo"

#: aiorubi.fsm.storage.mongo.MongoStorage:2 of
msgid "DEPRECATED: Use :class:`PyMongoStorage` instead. This class will be removed in future versions."
msgstr "منسوخ: به‌جایش از :class:`PyMongoStorage` استفاده کنید. این کلاس در نسخه‌های آینده حذف خواهد شد."

#: aiorubi.fsm.storage.mongo.MongoStorage:6 of
msgid "MongoDB storage required :code:`motor` package installed (:code:`pip install motor`)"
msgstr "استورج MongoDB نیاز به نصب پکیج :code:`motor` دارد (:code:`pip install motor`)"

#: aiorubi.fsm.storage.mongo.MongoStorage.__init__:1 of
msgid "Instance of AsyncIOMotorClient"
msgstr "نمونه‌ای از AsyncIOMotorClient"

#: aiorubi.fsm.storage.mongo.MongoStorage.__init__:3
