#: aiorubi.client.context_controller.BotContextController.model_post_init:1 of
msgid "Override this method to perform additional initialization after `__init__` and `model_construct`. This is useful if you want to do some validation that requires the entire model to be initialized."
msgstr "این متد را برای انجام مقداردهی اضافی پس از `__init__` و `model_construct` بازنویسی (override) کنید. اگر اعتبارسنجی‌ای می‌خواهید که به مقداردهی کامل مدل نیاز دارد، این روش مفید است."

#: aiorubi.methods.base.Response.data:1 of
msgid "Main data payload from Rubika."
msgstr "بار اصلی داده از روبیکا."

#: aiorubi.methods.base.Response.dev_message:1 of
msgid "Error description for developers."
msgstr "توضیح خطا برای توسعه‌دهندگان."

#: aiorubi.methods.base.Response.status:1 of
msgid "Response status (e.g., 'OK' or 'INVALID_ACCESS')."
msgstr "وضعیت پاسخ (مثلاً 'OK' یا 'INVALID_ACCESS')."

#: ../../api/methods.rst:18
msgid "Chat members"
msgstr "اعضای چت"

#: aiorubi.methods.ban_chat_member.BanChatMember:1 of
msgid "Use this method to ban a user in a group or a channel. Returns :code:`True` on success."
msgstr "از این متد برای مسدودکردن یک کاربر در گروه یا کانال استفاده کنید. در صورت موفقیت :code:`True` برمی‌گرداند."

#: aiorubi.methods.ban_chat_member.BanChatMember:4 of
msgid "Source: https://rubika.ir/botapi/methods#_15"
msgstr "منبع: https://rubika.ir/botapi/methods#_15"

#: aiorubi.methods.ban_chat_member.BanChatMember.chat_id:1
#: aiorubi.methods.delete_message.DeleteMessage.chat_id:1
#: aiorubi.methods.edit_chat_keypad.EditChatKeypad.chat_id:1
