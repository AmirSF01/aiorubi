msgid "link"
msgstr "لینک"

#: aiorubi.utils.payload.decode_payload:1 of
msgid "Decode URL-safe base64url payload with decoder."
msgstr "کدگشایی payload با base64url امنِ URL به‌کمک decoder."

#: aiorubi.utils.payload.encode_payload:1 of
msgid "Encode payload with encoder."
msgstr "کدگذاری payload با encoder."

#: aiorubi.utils.payload.encode_payload:3 of
msgid "Result also will be encoded with URL-safe base64url."
msgstr "نتیجه همچنین با base64url امنِ URL کدگذاری می‌شود."

