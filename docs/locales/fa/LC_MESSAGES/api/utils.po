msgid "Create deep link."
msgstr "ساخت دیپ‌لینک."

#: aiorubi.utils.deep_linking.create_deep_link:4 of
msgid "any string-convertible data"
msgstr "هر داده‌ای که به رشته قابل تبدیل باشد"

#: aiorubi.utils.deep_linking.create_deep_link:5
#: aiorubi.utils.deep_linking.create_start_link:7 of
