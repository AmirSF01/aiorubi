#: ../../api/utils.rst
msgid "Returns"
msgstr "بازگشت‌ها"

#: aiorubi.utils.deep_linking.create_deep_link:7 of
msgid "deeplink"
msgstr "دیپ‌لینک"

#: aiorubi.utils.deep_linking.create_start_link:1 of
msgid "Create 'st' deep link with your payload."
msgstr "ساخت دیپ‌لینک 'st' با payload دلخواه شما."

#: aiorubi.utils.deep_linking.create_start_link:3 of
msgid "If you need to encode payload or pass special characters - set encode as True"
msgstr "اگر لازم است payload کدگذاری شود یا کاراکتر خاصی پاس داده شود — encode را True بگذارید"

#: aiorubi.utils.deep_linking.create_start_link:5 of
