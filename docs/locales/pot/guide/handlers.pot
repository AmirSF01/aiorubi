msgid "Name"
msgstr ""

#: ../../guide/handlers.rst:28
msgid "Value"
msgstr ""

#: ../../guide/handlers.rst:29
msgid "``message``, ``inline_message``, ``event``"
msgstr ""

#: ../../guide/handlers.rst:30
msgid "The event object for the observer (a :class:`~aiorubi.types.message.Message`, an :class:`~aiorubi.types.inline_message.InlineMessage`, …)."
msgstr ""

#: ../../guide/handlers.rst:33
msgid "``bot``"
msgstr ""

#: ../../guide/handlers.rst:34
